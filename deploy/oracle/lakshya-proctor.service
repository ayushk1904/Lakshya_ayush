[Unit]
Description=Lakshya proctor AI (OpenCV + YOLO webcam checks)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=/opt/lakshya/proctor-ai
ExecStart=/opt/lakshya/proctor-ai/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
