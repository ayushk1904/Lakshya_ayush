[Unit]
Description=Lakshya backend (Express API)
After=network-online.target lakshya-planner.service lakshya-proctor.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=/opt/lakshya/server
# These win over server/.env: the AI services run on this same machine.
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=5000
Environment=PLANNER_AI_URL=http://127.0.0.1:8001 PROCTOR_AI_URL=http://127.0.0.1:8002
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
