[Unit]
Description=Lakshya planner AI (study planner + question-paper reading)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=/opt/lakshya/planner-ai
ExecStart=/opt/lakshya/planner-ai/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
