MONGODB_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/lakshya
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
SMTP_GMAIL_USER=your-email@gmail.com
SMTP_GMAIL_APP_PASSWORD=your-gmail-app-password
MAIL_FROM=Lakshya <your-email@gmail.com>
SMTP_ALLOW_SELF_SIGNED=false
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
PLANNER_AI_URL=http://127.0.0.1:8001
# Optional shared secret; set the same value for the planner-ai service
PLANNER_AI_TOKEN=
PROCTOR_AI_URL=http://127.0.0.1:8002
# Optional shared secret; set the same value for the proctor-ai service
PROCTOR_AI_TOKEN=
