# Copy to .env in this folder. Existing server/.env values are also loaded as fallbacks.
MONGODB_URI=mongodb://127.0.0.1:27017/lakshya
JWT_SECRET=replace-with-a-long-random-secret
HOST=127.0.0.1
PORT=5000
# Trust the OS certificate store as well as Node's bundled CAs (Node 22.19+/24.6+).
NODE_USE_SYSTEM_CA=1

# Local AI: no Gemini, Groq or other paid AI key is needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=300
# Smaller default context saves GPU memory; long documents can use the larger limit.
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_CTX=16384
# -1 keeps Qwen loaded between requests. The backend also preloads it on startup.
OLLAMA_KEEP_ALIVE=-1
OLLAMA_LOG_TIMINGS=false

# Paper reading: parse printed questions directly and use AI only for ambiguous layouts.
PAPER_AI_ENRICHMENT=false
OCR_THREADS=4
OCR_REC_BATCH_SIZE=8
OCR_DETECTION_MODE=page
OCR_DET_SIDE_LEN=1280

# Your assigned domain from https://dashboard.ngrok.com/domains (hostname only).
# Configure the account token once with: ngrok config add-authtoken YOUR_TOKEN
NGROK_DOMAIN=
# Optional: use the token from the account that owns NGROK_DOMAIN for this project only.
# NGROK_AUTHTOKEN=your-token

# Optional YouTube search and email password reset settings.
YOUTUBE_API_KEY=
SMTP_GMAIL_USER=
SMTP_GMAIL_APP_PASSWORD=
MAIL_FROM=
SMTP_ALLOW_SELF_SIGNED=false
APP_TIMEZONE=Asia/Kolkata

# Optional; use the same values on the backend and Python services.
PLANNER_AI_TOKEN=
PROCTOR_AI_TOKEN=
